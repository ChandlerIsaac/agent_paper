# MIMO model
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://your-mimo-compatible-endpoint.example/v1
MODEL_NAME=your_model_name_here

# Local embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
EMBEDDING_DEVICE=cuda
EMBEDDING_OFFLINE=true

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=researchmate

# Local persistence and retrieval
DATABASE_PATH=data/researchmate.sqlite3
UPLOAD_DIR=data/uploads
MILVUS_LITE_PATH=data/milvus/researchmate.db
MILVUS_COLLECTION=researchmate_chunks
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=5
HYBRID_SEARCH_ENABLED=true
HYBRID_CANDIDATE_K=10
RRF_RANK_CONSTANT=60

# Multi-user cookies: false for localhost SSH access, true behind HTTPS
COOKIE_SECURE=false
# Crossref is public scholarly metadata; Tavily is general web search with an API key
WEB_SEARCH_PROVIDER=crossref
WEB_SEARCH_TIMEOUT=20
TAVILY_API_KEY=
